    {
      "parameters": {
        "jsCode": "// Build the final response object for storage, logging, and the webhook reply.\nconst rv = $('Response Validation').first().json;\nlet ticket_id = rv.ticket_id != null ? rv.ticket_id : null;\ntry {\n  const t = $('Create Escalation Ticket').first().json;\n  if (t && t.ticket_id != null) ticket_id = t.ticket_id;\n} catch (e) { /* not escalated */ }\n\nlet response = rv.response || '';\nif (rv.escalated && !/human/i.test(response)) {\n  response = (response ? response + ' ' : '') + 'Your request has been forwarded to a human support agent who will follow up shortly.';\n}\n\nreturn [{ json: {\n  conversation_id: rv.conversation_id,\n  customer_id: rv.customer_id,\n  intent: rv.intent,\n  response,\n  escalated: !!rv.escalated,\n  ticket_id,\n  errors: rv.errors || null,\n} }];"
      },
