        "inputSchema": "{\"type\":\"object\",\"properties\":{\"intent\":{\"type\":\"string\",\"enum\":[\"FAQ\",\"Product question\",\"Order status\",\"Refund\",\"Cancellation\",\"Complaint\",\"Technical support\",\"Human support\",\"Other\"]},\"response\":{\"type\":\"string\"},\"escalate\":{\"type\":\"boolean\"},\"escalation_reason\":{\"type\":\"string\"}},\"required\":[\"intent\",\"response\",\"escalate\"]}"
      },
      "id": "23ba87e6-50b3-4e52-8820-25d45b208485",
      "name": "Support Output Parser",
