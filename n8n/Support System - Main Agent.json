    {
      "parameters": {
        "jsCode": "// Validate/sanitize the agent output and produce a safe classification object.\nconst item = $input.first().json;\nconst vi = $('Validate Input').first().json;\nconst cls = item.output || null;\n\nlet intent = (cls && cls.intent) || 'Other';\nlet response = (cls && cls.response ? String(cls.response) : '');\nlet escalate = !!(cls && cls.escalate === true);\nlet reason = (cls && cls.escalation_reason) || null;\nlet errors = null;\n\n// Agent error output (no parsed output present) -> safe escalation\nif (!cls) {\n  escalate = true;\n  intent = 'Human support';\n  reason = 'AI processing failed';\n  const e = item.error;\n  errors = (e && (e.message || JSON.stringify(e))) || 'agent_error';\n  response = '';\n}\n\n// Security: strip any leaked secrets / prompt markers\nconst banned = [/sk-[A-Za-z0-9]{12,}/g, /api[_-]?key\\s*[:=]\\s*\\S+/gi, /system prompt/gi, /BEGIN [A-Z ]*PRIVATE KEY/gi];\nfor (const re of banned) { response = response.replace(re, '[redacted]'); }\n\n// Fallback when empty\nif (!response || !response.trim()) {\n  response = 'Sorry, I was unable to fully process your request. I am connecting you with a human support agent.';\n  escalate = true;\n  if (!reason) reason = 'empty_response';\n}\n\nreturn [{ json: {\n  conversation_id: vi.conversation_id,\n  customer_id: vi.customer_id,\n  intent,\n  response,\n  escalated: escalate,\n  escalation_reason: reason,\n  ticket_id: null,\n  errors,\n} }];"
      },
      "id": "11e391ae-bbcb-4f43-85bf-c0224e9d2eb2",
      "name": "Response Validation",
