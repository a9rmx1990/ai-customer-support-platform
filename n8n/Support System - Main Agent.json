      "parameters": {
        "jsCode": "// Validate and normalize the incoming payload.\nconst body = ($input.first().json.body) || {};\nconst customer_id = (body.customer_id || '').toString().trim();\nlet conversation_id = (body.conversation_id || '').toString().trim();\nconst message = (body.message || '').toString().trim();\nconst valid = customer_id.length > 0 && message.length > 0;\nif (!conversation_id) {\n  conversation_id = 'conv-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);\n}\nreturn [{ json: { customer_id, conversation_id, message, valid } }];"
      },
      "id": "aa10fc47-e12e-4e3e-a533-874ed3567d11",
