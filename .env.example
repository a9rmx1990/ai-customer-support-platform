# n8n Live Webhook Connection (Connected to your active n8n cloud instance)
N8N_WEBHOOK_URL=https://a9rmx1990.app.n8n.cloud/webhook/support-agent
N8N_WEBHOOK_SECRET=your_shared_webhook_secret
CLINICAL_N8N_WEBHOOK_URL=https://your-n8n-host/webhook/clinical-medical-assistant


# Supabase (the app and n8n must use the same project/database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Use the Supabase pooler connection in the n8n Postgres credential.
SUPABASE_DB_HOST=your-project-pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# Google Gemini API Key (Required for live vector embeddings & LLM execution)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL + pgvector Database Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=n8n_support
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Google OAuth 2.0 Single Sign-On (SSO) Credentials
# Get keys from https://console.cloud.google.com/ -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here
