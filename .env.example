# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# n8n Support Agent Webhook Endpoint URL
# Leave empty to run in built-in Standalone Demo Mode
N8N_WEBHOOK_URL=http://localhost:5678/webhook/support-agent

# Optional n8n Webhook Authorization Secret
N8N_WEBHOOK_SECRET=

# Supabase Credentials (Used by n8n & direct DB queries if needed)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LLM API Key (Used by n8n or server-side fallback agent)
LLM_API_KEY=your-openai-api-key

# SMTP Credentials (Used for support team escalation emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@yourcompany.com
SMTP_PASS=your-app-password
